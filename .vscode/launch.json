{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AI Dungeon Explorer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Run unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "tests", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
